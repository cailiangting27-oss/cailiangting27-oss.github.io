  "knowledge": {
    "point": "平方千米的认识与换算",
    "core_concept": "测量国家、城市等极大的土地面积时，用平方千米作单位。边长是 1000 米（1 千米）的正方形面积是 1 平方千米。它比公顷大得多，1 平方千米等于 100 公顷。",
    "key_formula": "$1 \\text{平方千米} = 100 \\text{公顷} = 1000000 \\text{平方米}$",
    "common_mistakes": [
      "记错平方千米与公顷的进率，常与长度单位千米和米的进率 1000 混淆。",
      "在多级换算（平方千米到平方米）时漏写零。"
    ],
    "tips": "记住进率口诀：平方千米公顷一百倍，公顷变平米万万岁。",

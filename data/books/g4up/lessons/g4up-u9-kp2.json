  "knowledge": {
    "point": "图形与几何综合复习",
    "core_concept": "复习线段、射线、直线的区别；掌握角的分类（锐、直、钝、平、周角）；理解平行线和垂直线的定义，以及平行四边形和梯形的特征。",
    "key_formula": "平角 = 180°，周角 = 360°，1周角 = 2平角 = 4直角",
    "common_mistakes": [
      "混淆平行四边形和梯形的定义",
      "认为点到直线的距离是斜线段长度"
    ],
    "tips": "可以利用一副三角板拼出 15 倍数的各种角度。",

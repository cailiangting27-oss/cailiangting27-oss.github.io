  "knowledge": {
    "point": "角的认识与度量",
    "core_concept": "从一点引出两条射线所组成的图形叫做角。量角器是核心工具，要注意“点对点”（中心对顶点）、“线对线”（0线对角边）、“读准确”（看清内外圈）。",
    "key_formula": "角的度量单位是“度”，符号是 $^{\\circ}$。",
    "common_mistakes": [
      "内外圈读数混淆，将 $60^{\\circ}$ 读成 $120^{\\circ}$",
      "中心点未对准角顶点"
    ],
    "tips": "判断内外圈技巧：0刻度线在右边读内圈，0刻度线在左边读外圈。",

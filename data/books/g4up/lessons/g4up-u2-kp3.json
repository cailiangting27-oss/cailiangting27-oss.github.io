  "knowledge": {
    "point": "面积单位的综合应用",
    "core_concept": "根据物体实际大小选择合适的单位：课桌用平方分米，教室用平方米，公园/广场用公顷，城市/国家/行政区用平方千米。",
    "key_formula": "$\\text{长} \\times \\text{宽} = \\text{面积}$ (注意先统一长宽单位)",
    "common_mistakes": [
      "不看单位直接相乘，如长 500 米乘以宽 2 千米。",
      "生活经验不足，将学校面积填成平方千米。"
    ],
    "tips": "做题时先看清单位，如果是大数换小数就乘进率，小数换大数就除以进率。",

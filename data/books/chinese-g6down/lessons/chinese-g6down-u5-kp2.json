  "knowledge": {
    "point": "文言文实词与辩证思维",
    "core_concept": "理解文言文的关键在于掌握重点实词。如《学弈》中的指示代词“之”的不同指代对象。同时，学习古人的辩证思维，如两小儿从不同感官（视觉与触觉）出发产生的认知冲突。这不仅是语言学习，更是批判性思维和科学探索态度的启蒙。",
    "key_formula": "文言基础：一词多义辨析 + 逻辑点：现象背后的原因",
    "common_mistakes": [
      "混淆多音字和古今异义词，如将“汤”误解为“鸡汤”。",
      "忽略指示代词的指代对象，导致句意理解偏差。"
    ],
    "tips": "通过对比学习法，将两个人的学习表现或两小儿的观点画成对照表，加深记忆。",

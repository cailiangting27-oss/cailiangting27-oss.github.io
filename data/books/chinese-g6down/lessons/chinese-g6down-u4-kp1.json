  "knowledge": {
    "point": "古诗中的托物言志",
    "core_concept": "托物言志是一种通过描写具体事物（如竹子、石灰）来表达诗人个人志向、抱负或高尚节操的写作手法。在诗中，物即是人，物的特点（如石灰的洁白、竹子的坚韧）就是人的品格缩影。阅读时要将事物的物理属性与人的精神意义建立联系。",
    "key_formula": "具体事物（物）+ 事物特点（形）= 诗人的志向、精神（志）",
    "common_mistakes": [
      "误将单纯的状物诗（只写景）当成托物言志诗",
      "解释诗句时只停留在表面，不理解清白、坚劲的深层象征意义"
    ],
    "tips": "记住‘物人合一’，找找诗句中哪些词是形容物的，同时也可以形容人的品德。",

  "knowledge": {
    "point": "议论文的逻辑与论证",
    "core_concept": "议论文旨在通过论证来说服读者接受某个观点。本单元重点学习《为人民服务》中的逻辑：先提出中心论点，再从‘死得其所’、‘不怕批评’、‘团结互助’等层面展开。常用的方法有引用名人名言、举出真实事例或进行因果推理。",
    "key_formula": "观点（是什么）+ 理由（为什么）+ 结论（怎么做）",
    "common_mistakes": [
      "找不准文章的中心论点",
      "对逻辑关联词（因为、所以、即使）的使用不够敏感"
    ],
    "tips": "画出每一段的第一句话，通常它就是该段要讲的一个小理由。",

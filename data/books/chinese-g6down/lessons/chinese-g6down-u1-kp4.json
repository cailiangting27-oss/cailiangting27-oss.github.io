  "knowledge": {
    "point": "“先总后分”的逻辑结构",
    "core_concept": "一种经典的说明或叙事结构。开头部分用概括性的语言（甚至是反问、排比等修辞句）点明事物的核心特征或文章主旨，起到‘总领全文’的作用，后面再分设段落分别从不同角度详细论证或描述。",
    "key_formula": "总（全貌/观点）+ 分1（特征A）+ 分2（特征B）+ 分3（特征C）。",
    "common_mistakes": [
      "总起句与后面分述的内容不匹配",
      "分述部分之间逻辑混乱，没有并列关系"
    ],
    "tips": "背诵《藏戏》开头的三段，感受其先声夺人的气势和逻辑。",

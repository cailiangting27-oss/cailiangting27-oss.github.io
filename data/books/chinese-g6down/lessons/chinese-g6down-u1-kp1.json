  "knowledge": {
    "point": "详写与略写的处理技巧",
    "core_concept": "这是六年级习作的核心。即在写作前确立中心思想，凡是极能表现中心的内容要“浓墨重彩”详写，通过细节描写让内容生动；凡是与中心关系稍远但必须交代的则“一笔带过”略写。如《北京的春节》中，为了表现热闹，详写除夕、元宵，略写正月初六后的日子。",
    "key_formula": "详写＝动作＋对话＋心理＋环境；略写＝概述＋短句。",
    "common_mistakes": [
      "记流水账，眉毛胡子一把抓，每个环节字数一样多",
      "错把次要内容当成主要的写，导致偏题"
    ],
    "tips": "写作前列提纲，在重点项后面打星号，时刻提醒自己这一段要写具体。",

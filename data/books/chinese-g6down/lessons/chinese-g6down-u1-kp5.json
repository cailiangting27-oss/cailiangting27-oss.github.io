  "knowledge": {
    "point": "节日文化与托物言志",
    "core_concept": "学习传统文学中的民俗背景。通过古诗中提到的特定物像（如禁烟火、银河、桂花），联想到对应的节日（寒食、七夕、中秋），并体会诗人借这些景象表达出的对家乡、对亲人或对自己处境的复杂情感。",
    "key_formula": "物像（如明月）+ 节日场景 = 诗人情感（如思乡）。",
    "common_mistakes": [
      "死记硬背诗句，不理解背后的节日背景",
      "混淆不同节日的特定象征物，如把吃端午粽子记成春节"
    ],
    "tips": "建立一张‘节日-日期-习俗-古诗’的对照表，辅助联想记忆。",

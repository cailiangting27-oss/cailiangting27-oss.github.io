  "knowledge": {
    "point": "小数乘整数的算理与计算",
    "core_concept": "小数乘整数的计算方法是先按整数乘法计算，再看因数中有几位小数，就从积的右边起数出几位点上小数点。如果积的末尾有0，通常要去掉。",
    "key_formula": "$a.b \times c = (a \times 10 + b) \times c \times 10^{-1}$",
    "common_mistakes": [
      "点错小数点位置",
      "习惯性地将小数点对齐再计算"
    ],
    "tips": "先数因数的小数位数，点完小数点后再化简末尾的0。",

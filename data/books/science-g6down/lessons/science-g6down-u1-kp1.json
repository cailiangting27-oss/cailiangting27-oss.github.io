  "knowledge": {
    "point": "住房的结构与系统",
    "core_concept": "住房是由基本结构（梁、柱、墙等）和各种功能系统（供水、供电、通风等）组成的整体。",
    "key_formula": "住房=基本结构+配套系统+相关设施",
    "common_mistakes": [
      "认为装修风格也属于住房系统",
      "忽略了各系统之间在墙体内的交叉协作关系"
    ],
    "tips": "观察自家的总电闸、水表位置，能帮助理解系统的集成。",

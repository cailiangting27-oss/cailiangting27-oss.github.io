  "knowledge": {
    "point": "通过符号(=、>、<)比较大小",
    "core_concept": "用于描述数与数之间的大小关系。开口向大数，尖尖对小数。两数相等用等号（=），左边大用大于号（>），右边大用小于号（<）。",
    "key_formula": "大数 > 小数；小数 < 大数；等数 = 等数",
    "common_mistakes": [
      "分不清大于号 > 和小于号 < 的方向。",
      "在比较算式结果和数字时，忘记先计算出算式的得数。"
    ],
    "tips": "可以记住儿歌：开口朝大数，尖尖对小数，两边相等画二横。",

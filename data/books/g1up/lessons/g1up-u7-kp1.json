  "knowledge": {
    "point": "钟面结构的认识",
    "core_concept": "钟面是一个圆盘，上面均匀分布着12个数。长且细的针叫分针，短且粗的针叫时针。它们按照顺时针方向不停地转动。",
    "key_formula": "钟面 = 12个数字 + 时针(短) + 分针(长)",
    "common_mistakes": [
      "混淆时针和分针，把长针当成时针",
      "数刻度时数错，分不清数字对应的位置"
    ],
    "tips": "记住顺口溜：长长细细是分针，短短胖胖是时针。",

  "knowledge": {
    "point": "长方体和正方体体积公式应用",
    "core_concept": "体积的大小由底面积和高决定。通过底面积乘以高可以统一计算长方体和正方体的体积。",
    "key_formula": "$V=abh$ 或 $V=Sh$",
    "common_mistakes": [
      "计算正方体体积时用棱长乘以3（应是三个棱长相乘）",
      "公式应用时单位不统一就直接相乘"
    ],
    "tips": "看到底面积和高，直接相乘就是体积！一定要统一单位再计算。",

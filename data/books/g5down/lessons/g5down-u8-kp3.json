  "knowledge": {
    "point": "称量次数与物体数量的规律总结",
    "core_concept": "物体总数 $n$ 与保证找出次品的最少次数 $k$ 之间满足：$3^{k-1} < n \times 3^k$。即：3个以内1次，9个以内2次，27个以内3次，以此类推。",
    "key_formula": "$3^{k}$ 规律",
    "common_mistakes": [
      "记混幂运算结果，例如把 $3^3$ 算成 9 而不是 27。",
      "无法准确判断数量所在的区间，如认为 10 个只需要 2 次（实际要 3 次）。"
    ],
    "tips": "背熟 3 的前 5 次幂：3, 9, 27, 81, 243，考试时直接对号入座找区间。",

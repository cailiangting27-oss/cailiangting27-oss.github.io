  "knowledge": {
    "point": "数的奇偶性运算规律",
    "core_concept": "研究奇数与偶数通过加减乘运算后的结果性质。规律包括：奇数 + 奇数 = 偶数，偶数 + 偶数 = 偶数，奇数 + 偶数 = 奇数；奇数 $\times$ 奇数 = 奇数，奇数 $\times$ 偶数 = 偶数，偶数 $\times$ 偶数 = 偶数。",
    "key_formula": "\\text{奇}+\\text{奇}=\\text{偶}, \\text{奇}+\\text{偶}=\\text{奇}, \\text{偶}+\\text{偶}=\\text{偶}",
    "common_mistakes": [
      "记混加法和乘法的规律",
      "在处理多个数连加时，没看奇数出现的次数"
    ],
    "tips": "不确定规律时，可以用最简单的数字（如 1 和 2）代入验算。",

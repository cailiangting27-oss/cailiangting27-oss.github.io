  "knowledge": {
    "point": "2、5、3的倍数特征",
    "core_concept": "2 的倍数特征：个位上是 0, 2, 4, 6, 8；5 的倍数特征：个位上是 0 或 5；3 的倍数特征：各位数字之和是 3 的倍数。整数中，是 2 的倍数的数叫做偶数（0 也是偶数），不是 2 的倍数的数叫做奇数。",
    "key_formula": "3 \\text{ 的倍数} \\Rightarrow \\text{各位数字之和} \\div 3 = \\text{整数}$",
    "common_mistakes": [
      "通过看个位来判断 3 的倍数（如误认为 13, 16, 19 是 3 的倍数）",
      "漏掉 0 也是偶数"
    ],
    "tips": "同时是 2, 3, 5 的倍数，个位一定是 0，且各位数字之和是 3 的倍数。",

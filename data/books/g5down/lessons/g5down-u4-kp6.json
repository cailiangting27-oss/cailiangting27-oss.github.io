  "knowledge": {
    "point": "通分与最小公倍数",
    "core_concept": "两个数公有的倍数叫公倍数，其中最小的一个叫最小公倍数。把异分母分数分别化成和原来分数相等的同分母分数，叫做通分。通常取分母的最小公倍数作为公分母。",
    "key_formula": "通分：找分母的最小公倍数 $\\rightarrow$ 利用基本性质转化",
    "common_mistakes": [
      "通分时只把分母变了，分子忘了根据扩大倍数进行计算",
      "求最小公倍数时与最大公因数的计算方法弄混"
    ],
    "tips": "通分主要用于比较大小和异分母分数加减法。",

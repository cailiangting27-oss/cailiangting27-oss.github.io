  "knowledge": {
    "point": "容积与不规则物体体积测量",
    "core_concept": "容积指容器内部空间大小。不规则物体（如石块）丢进水里，上升那部分水的体积就是该物体的体积（排水法）。",
    "key_formula": "$V_{\\text{物}} = S_{\\text{容}} \\times h_{\\text{升}}$",
    "common_mistakes": [
      "计算容积时用了外部测量数据",
      "混淆1升水等于1立方厘米（实为1立方分米）"
    ],
    "tips": "排水法计算秘籍：物体的体积 = 放入后高度 - 放入前高度 × 底面积。",

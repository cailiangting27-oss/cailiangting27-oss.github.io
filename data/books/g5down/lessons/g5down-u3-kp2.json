  "knowledge": {
    "point": "表面积计算与展开图",
    "core_concept": "表面积是物体6个面面积的总和。计算时要根据实际情况确定计算几个面，如鱼缸、粉刷教室等往往只有5个面或4个面。",
    "key_formula": "长方体 $S=2(ab+ah+bh)$，正方体 $S=6a^{2}$",
    "common_mistakes": [
      "无盖水箱计算了6个面的面积",
      "计算长方体表面积时漏乘2"
    ],
    "tips": "做题前先脑补一下物体长什么样，需不需要计算“底面”和“盖子”。",

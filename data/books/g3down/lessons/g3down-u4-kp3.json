  "knowledge": {
    "point": "解决两步计算的应用题",
    "core_concept": "解决连乘、连除问题时，首先要理清题目中的数量关系。可以从条件入手思索能求出什么，也可以从问题入手思索需要什么条件。通常需要两步计算才能得出最后结果。",
    "key_formula": "总数 = \text{份数} \times \text{每份数量} \times \text{倍数}",
    "common_mistakes": [
      "找不到隐藏的中间量",
      "混淆乘除关系导致运算符号选错"
    ],
    "tips": "读题两遍理思路，先求中间再求终。连乘连除看含义，结合生活更轻松。",

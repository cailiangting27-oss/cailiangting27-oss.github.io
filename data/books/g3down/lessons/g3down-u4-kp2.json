  "knowledge": {
    "point": "不进位与进位的笔算乘法",
    "core_concept": "笔算两位数乘两位数时，用第二个因数的每一位分别去乘第一个因数。用第二个因数十位上的数去乘时，积的末位要和十位对齐。最后把两次乘得的积相加。",
    "key_formula": "两位数 \times 两位数 = \text{部分积}_1 + \text{部分积}_2",
    "common_mistakes": [
      "用十位数乘时积的末位与个位对齐",
      "进位加法漏算"
    ],
    "tips": "相同数位要对齐，从个位起依次乘。十位乘积写十位，最后相加是总积。",

  "knowledge": {
    "point": "认识面积单位",
    "core_concept": "为了准确计量面积，需要统一面积单位。常用的有：平方厘米（cm²，边长1cm的正方形）、平方分米（dm²，边长1dm的正方形）、平方米（m²，边长1m的正方形）。",
    "key_formula": "1 平方厘米 $\\approx$ 指甲盖；1 平方分米 $\\approx$ 手掌；1 平方米 $\\approx$ 展开后的餐桌面积。",
    "common_mistakes": [
      "忘记带‘平方’二字，把面积单位写成长途单位（米、厘米）",
      "单位感知错误，如给教室地面选‘平方分米’"
    ],
    "tips": "寻找身边的参照物记忆：大拇指指甲约1平方厘米，成人手掌约1平方分米。",

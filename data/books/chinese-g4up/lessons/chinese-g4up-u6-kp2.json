  "knowledge": {
    "point": "人物心理活动的揣摩",
    "core_concept": "心理活动是人物性格的灵魂。除了直接刻画（如：我想……），作者更多地通过动作描写（手心出汗）、神态描写（俏脸通红）或环境描写（风阴冷地吹）来侧面烘托人物的内心世界。学生需要学会从这些表象中“读懂”人物到底是害怕、兴奋还是惭愧。",
    "key_formula": "动作/神态/语言 + 生活经验 = 人物内心。",
    "common_mistakes": [
      "容易把动作描写和心理描写混为一谈。",
      "推断人物心理不结合语境，导致情感推导偏差。"
    ],
    "tips": "尝试把自己置换到文中情境，问自己：如果是我，这时候在想什么？",

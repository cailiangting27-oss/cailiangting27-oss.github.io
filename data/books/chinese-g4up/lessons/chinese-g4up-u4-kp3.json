  "knowledge": {
    "point": "神话题材叙事结构复述",
    "core_concept": "神话故事通常有非常明确的叙事链：因为发生了某种宏大的灾难或不便（起因），英雄决定去解决（经过，往往伴随三次尝试或长期抗争），最后世界恢复秩序或产生新物种（结果）。复述时必须抓准这条主线。",
    "key_formula": "叙事三部曲 = 灾难/初创（起因） + 历险/抗争（经过） + 变化/和平（结果）",
    "common_mistakes": [
      "经过描述过于简略，直接从起因跳到结果。",
      "复述时缺乏描述性的词汇，把富有美感的文字变成了生硬的流水账。"
    ],
    "tips": "分段绘制“情节坐标轴”，标记出故事的高潮点，复述时重点突出英雄努力的过程。",

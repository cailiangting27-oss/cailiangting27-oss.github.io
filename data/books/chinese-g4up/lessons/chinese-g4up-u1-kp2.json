  "knowledge": {
    "point": "动态描写与修辞赏析",
    "core_concept": "动态描写能赋予死板的文字灵动的生命。通过比喻（将浪潮比作战马）、拟人（钱塘江横卧）等修辞方式，将抽象的力度和规模具象化。这种方法能让学生理解文字背后的“力量感”。",
    "key_formula": "画面感 = 具体名词 + 形容词/动词 + 恰当的修辞。",
    "common_mistakes": [
      "形容词使用单调，只会写“很大”、“很响”。",
      "比喻不恰当，如将壮观的浪潮比作微小的物体。"
    ],
    "tips": "多背诵积累优美的比喻句，模仿其结构进行口头训练。",

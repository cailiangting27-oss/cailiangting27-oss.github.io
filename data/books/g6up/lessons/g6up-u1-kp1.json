  "knowledge": {
    "point": "分数乘整数的意义与计算",
    "core_concept": "分数乘整数表示求几个相同分数的和的简便运算，或者是求一个整数的几分之几是多少。计算时，只需用分子与整数相乘的积作为分子，分母保持不变。在计算过程中，能约分的可以先约分，使计算简便。",
    "key_formula": "$\\frac{a}{b} \\times n = \\frac{a \\times n}{b}$",
    "common_mistakes": [
      "错误地用分母与整数相乘",
      "忘记约分导致结果不是最简分数"
    ],
    "tips": "记住“分子乘整数，分母不动”的原则，看到大数字先看能不能约分。",

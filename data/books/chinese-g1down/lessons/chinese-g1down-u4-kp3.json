  "knowledge": {
    "point": "端午民俗与背景认知",
    "core_concept": "端午节是每年的农历五月初五，是中华民族重要的传统节日。它的主要习俗包括吃粽子、赛龙舟、挂艾草。核心文化含义是纪念战国时期楚国的爱国诗人屈原。了解这些内容能增强对家乡和民族文化的感情。",
    "key_formula": "五月初五端午节，粽子咸甜寄屈原。",
    "common_mistakes": [
      "混淆端午节和中秋节（吃月饼）的习俗",
      "分不清农历（阴历）和阳历（公历）的日期"
    ],
    "tips": "通过节气歌或节日歌谣来记忆，联想家里的生活习惯更容易记住。",

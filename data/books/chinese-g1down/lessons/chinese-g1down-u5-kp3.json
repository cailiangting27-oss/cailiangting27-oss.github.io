  "knowledge": {
    "point": "打电话礼仪规范",
    "core_concept": "在口语交际中，学习打电话的文明礼貌方案。包括：接通后先问好、清晰报上自己的姓名、有礼貌地提出请求（如请找谁接电话）、转接时表示感谢、结束时说再见。",
    "key_formula": "问好 + 我是谁 + 找谁 + 谢谢 + 再见",
    "common_mistakes": [
      "忘记自报家门，让对方猜是谁",
      "不使用‘请、您、你好’等礼貌语言"
    ],
    "tips": "可以和爸爸妈妈在家进行角色扮演，模拟给老师或同学打电话的场景。",

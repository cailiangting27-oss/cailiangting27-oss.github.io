  "knowledge": {
    "point": "童话的拟人化特点",
    "core_concept": "童话通过丰富的想象，赋予动植物、物品以人的思想、行为和真挚深厚的感情。它通过奇妙的情节展现现实生活中可能存在的各种情感关系和哲理，让读者在不可思议的幻想中感受到成长的力量。",
    "key_formula": "物 + 人的表情/语言/动作 = 拟人化的童话形象",
    "common_mistakes": [
      "只会写小动物说说话，不具备真实的性格特征",
      "情节设计完全脱离生活逻辑，导致故事不可信"
    ],
    "tips": "观察生活中的人是怎么说话做事的，然后把这些特点‘借’给你的动植物主角。",

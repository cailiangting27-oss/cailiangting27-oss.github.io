  "knowledge": {
    "point": "课文阅读与画面想象",
    "core_concept": "在读富有想象力的文章（如《花的学校》）时，能够根据文字描述在脑海中勾勒出具体的动态或静态画面。尤其要理解作者把自然界中的景物赋予人的情感和行为，感受文字背后的童真与美感。",
    "key_formula": "文字转换画面 = 抓住动词 + 联想生活经历 + 填补想象空间",
    "common_mistakes": [
      "无法理解抽象的拟人描写（如：拍着大手的雷云）",
      "想象画面时脱离文本内容胡乱联想"
    ],
    "tips": "可以尝试闭上眼睛，像看电影电影片段一样回想刚才读的内容。",

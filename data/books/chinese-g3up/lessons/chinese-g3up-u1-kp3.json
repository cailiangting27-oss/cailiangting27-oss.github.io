  "knowledge": {
    "point": "成语的构成与积累",
    "core_concept": "一单元重点积累了含有身体部位名称（头、脸、鼻、口、耳、手、脚等）的成语。这类成语通常具有形象生动、对称性强的特点，很多还包含动作词，能够准确传达人的神态、心情或动作。",
    "key_formula": "身体成语 = （身体部位A + 动作/性质） + （身体部位B + 动作/性质）",
    "common_mistakes": [
      "成语字形写错（如：面红耳‘赤’误写为‘吃’）",
      "理解偏差，不清楚成语是描写神态还是心理"
    ],
    "tips": "通过做动作或观察同桌的表情来辅助记忆“摇头晃脑”“目瞪口呆”等词语。",

  "knowledge": {
    "point": "借物抒情与借物喻人",
    "core_concept": "借物抒情是指通过对客观事物的描写，来表达作者主观的情感；借物喻人则是将人的某种品格或志向寄托在具体的物象上，使抽象的道理通过具象的物体传达出来。例如《落花生》中利用花生‘埋在地里’、‘朴实无华’的特点，比喻那些默默奉献、不求虚名的人。",
    "key_formula": "观察事物特点 + 产生相关联想 + 表达志向情感",
    "common_mistakes": [
      "只写物不写人，导致文章变成纯粹的状物文",
      "物与人的特点联系牵强，缺乏逻辑性"
    ],
    "tips": "要找准物与人之间的‘连接点’，如花生的‘有用’和人的‘贡献’。",

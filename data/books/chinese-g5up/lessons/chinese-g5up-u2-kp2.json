  "knowledge": {
    "point": "借助关键词句筛选信息",
    "core_concept": "在阅读中，通过识别段落的中心句、起始句、总结句，以及带动作、时间、逻辑关联词（如“但是”、“总之”）的关键词，可以迅速略过次要的描写性内容，直接抓取文章的核心骨架和相关事实数据。",
    "key_formula": "抓首尾句，寻关联词，瞄关键词。",
    "common_mistakes": [
      "平均用力，每一个字都仔细研读导致速度过慢",
      "找不到中心句，把具体的举例说明当成了核心观点"
    ],
    "tips": "阅读前先看课后习题或带着“是什么、为什么、怎么样”的问题去扫描，目光会像扫描仪一样精准捕捉目标词汇。",

  "knowledge": {
    "point": "创造性复述故事",
    "core_concept": "在完整把握原故事主干的基础上，通过改变视角、润色细节和补充想象，使故事更具表现力。具体手段包括：第一人称叙述（增强代入感）、增加心理描写或环境渲染（使形象丰满）、对故事中的‘空白点’进行合理扩充。这不仅仅是记忆的还原，更是基于理解的二度创作，有助于锻炼表达和思维能力。",
    "key_formula": "保住骨干 + 改变人称 + 扩充细节 = 创造性复述",
    "common_mistakes": [
      "复述时改变了故事的原意或漏掉关键的核心逻辑",
      "想象过度，脱离了民间故事原有的风格背景"
    ],
    "tips": "想象一下如果自己是当事人，当时会说出什么样的话、做出什么样的动作，从而自然地增加细节。",

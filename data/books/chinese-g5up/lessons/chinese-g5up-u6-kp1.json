  "knowledge": {
    "point": "场景与细节描写刻画人物",
    "core_concept": "通过对人物具体的动作（如：掏、塞）、外貌（如：干瘦、褐色的口罩）、神态或特定环境（如：阴暗、震耳欲聋的厂房）的精确描述，来烘托人物的情感状态和性格品质。这种描写方式能让读者产生“如见其人”的真实感，使人物形象更加丰满。",
    "key_formula": "具体动作/外貌/环境 + 情感倾向 = 生动的人物形象",
    "common_mistakes": [
      "描写过于笼统，只用“很辛苦”等形容词，缺乏细节支撑。",
      "分不清环境描写的作用，忽略了环境对人物心情的衬托。"
    ],
    "tips": "写作时尝试闭上眼睛想象画面，把大动作分解成三个连续的小动作。",

  "knowledge": {
    "point": "地质化石与地理变迁的科普认知",
    "core_concept": "岩石是大自然的“百科全书”。通过观察其中的化石（如鱼印记、树叶印记）以及雨痕、波痕，可以推断出现在的陆地在很久以前可能是海洋或丛林。这种现象被称为“地壳运动”。",
    "key_formula": "岩石化石遗迹 = 环境历史缩影。",
    "common_mistakes": [
      "不理解鱼化石为什么会出现在高山上",
      "分不清什么是“印记”和“实物”"
    ],
    "tips": "把岩石想象成一本厚厚的日记，上面的花纹就是大自然写下的文字。",

  "knowledge": {
    "point": "社会分工与劳动成果的认知",
    "core_concept": "《千人糕》通过对米糕制作过程的描述，展示了农业、工业、运输业等多个环节的相互协作。让学生明白任何一个细小的日常用品，其背后都隐藏着无数人的辛勤汗水，从而产生对劳动者的敬意和感恩之心。",
    "key_formula": "普通物 + 复杂流程 = 辛劳成果",
    "common_mistakes": [
      "误认为千人糕是由一千人做的特殊糕点",
      "不理解糖、包装纸等配套环节也是生产的一部分"
    ],
    "tips": "可以用“倒推法”，从盘中的食物回想超市、工厂、农田的场景。",

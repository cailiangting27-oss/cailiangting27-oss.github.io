  "knowledge": {
    "point": "人民币的加减运算与购物应用",
    "core_concept": "学习在购物场景中计算总价和找零。相同单位可以直接相加减，单位不同时必须先换算成相同单位再算。",
    "key_formula": "$总价 = 单价1 + 单价2, 找回的钱 = 付出的钱 - 总价$",
    "common_mistakes": [
      "计算找零时，单位没有对齐（元减角）",
      "10角减3角算错成13角（由于加减号混淆）"
    ],
    "tips": "买东西找零时，先把1元看成10角就好算了。",

  "knowledge": {
    "point": "七巧板的综合应用",
    "core_concept": "七巧板是我国古代的一种构图玩具，由7块板组成：包括5个三角形（2大1中2小）、1个正方形和1个平行四边形。利用这7块板可以拼出千变万化的图案。",
    "key_formula": "七巧板构成：5三角形 + 1正方形 + 1平行四边形 = 7块。",
    "common_mistakes": [
      "错误地认为七巧板里有长方形、圆形。",
      "记不清各种形状的数量，尤其是容易漏掉平行四边形。"
    ],
    "tips": "记住“511”口诀：5个三角，1个正方，1个平四，总共是七。",

  "knowledge": {
    "point": "单韵母及其四声调认读",
    "core_concept": "单韵母是汉语拼音中最基础的部分，共有a, o, e, i, u, ü六个。发音时口形保持不变。四声调是汉语的特色，分为阴平（一声）、阳平（二声）、上声（三声）、去声（四声）。学生需要掌握它们的发音特点、口形变化以及在四线三格中的书写位置。",
    "key_formula": "一声平，二声扬，三声拐弯，四声降。",
    "common_mistakes": [
      "标调符号方向写反（尤其是二声和四声混淆）",
      "字母i标调时忘记去掉上面的点"
    ],
    "tips": "通过口型记忆：张大嘴巴aaa，圆圆嘴巴ooo，扁扁嘴巴eee。",

  "knowledge": {
    "point": "身份认同与角色定位",
    "core_concept": "学生通过《我是中国人》《上学歌》等内容，明确自己的多重身份。首先是建立深厚的民族自豪感，知晓国名、国旗，初步产生爱国情感。其次是认同“小学生”的新身份，理解学生阶段的主要任务是学习，并培养积极向上的学习态度和爱劳动的习惯。",
    "key_formula": "我是中国人，我是小学生。",
    "common_mistakes": [
      "国名书写或发音不准确",
      "混淆国旗底色和星的颜色"
    ],
    "tips": "通过观察国旗图片和学唱《上学歌》来辅助身份认同的内化。",

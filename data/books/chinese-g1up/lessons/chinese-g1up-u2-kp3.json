  "knowledge": {
    "point": "身体部位识记与行为规范",
    "core_concept": "“口、耳、目、手、足”是人最重要的五个感官和劳动器官。识记这些文字需要结合学生自身的身体部位进行点位认读。同时，通过“站如松、坐如钟”等成语，将汉字学习与日常行为规范教育（立德树人）相结合，让学生理解良好的坐立行走姿态不仅是礼仪，也保护骨骼发育。",
    "key_formula": "指认部位说汉字，规范姿势促成长。",
    "common_mistakes": [
      "“目”和“日”混淆（多写或少写一横）",
      "“耳”的长横位置写错"
    ],
    "tips": "玩“我说你指”游戏，家长说出身体部位，孩子指着部位并报出对应的汉字。",

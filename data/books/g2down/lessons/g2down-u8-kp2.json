  "knowledge": {
    "point": "质量单位“千克”的认识",
    "core_concept": "千克是常用的质量单位，也叫公斤。常用于计量较重物品，如人的体重、大米、水果、动物等。学生可以通过提一瓶1升的矿泉水（约1千克）来感受单位重。",
    "key_formula": "计量较重物品用“千克(kg)”作单位。",
    "common_mistakes": [
      "读秤盘面读数错误，将指针位置看错",
      "认为千克只用于食物，不知体重也用千克"
    ],
    "tips": "找找家里的5升油或5千克米，亲手提一提，感受“重”的程度。",

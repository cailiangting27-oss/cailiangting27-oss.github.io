  "knowledge": {
    "point": "质量单位“克”的认识",
    "core_concept": "克是一个较小的质量单位，通常用来计量轻薄、微小的物品。学生可以通过捏起一枚2分硬币感悟1克的重量。生活中，一枚大枣、一粒口香糖约1-5克，一个鸡蛋大约50-60克。",
    "key_formula": "计量较轻物品用“克(g)”作单位。",
    "common_mistakes": [
      "将克与长度单位厘米混淆",
      "对克没有感性认识，认为一个小球重1克（实际可能100克）"
    ],
    "tips": "记住“1枚2分硬币重1克”，用这个标准去估测其他轻的物体。",

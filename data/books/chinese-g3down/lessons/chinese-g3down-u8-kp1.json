  "knowledge": {
    "point": "复述故事的策略与支架应用",
    "core_concept": "复述不是背诵原文，而是通过对故事主要情节的内化，用自己的语言表达出来。本单元介绍了利用时间线（第一天...一年后）或地点转换图等作为支撑框架，帮助大脑建立逻辑链条，避免遗漏关键情节。",
    "key_formula": "复述 = 梳理支架（时间/地点/人物）+ 抓住重点（起因/经过/结果）+ 自我表达（连句成段）",
    "common_mistakes": [
      "把复述等同于背诵，导致中途忘词卡壳",
      "只讲精彩片段，忽略了故事基本的因果逻辑"
    ],
    "tips": "可以先在草稿纸上画简单的火柴人连线图，边看图边讲故事效果最好。",

  "knowledge": {
    "point": "轴对称图形的补全",
    "core_concept": "轴对称图形的核心是‘对应’和‘相等’。画另一半时，先找到原图形各个关键顶点，量出它们到对称轴的格数，然后在对称轴另一侧对应位置标出格数相同的点，最后顺次连接。",
    "key_formula": "对应点距离 = 对应点到对称轴的格数",
    "common_mistakes": [
      "找对应点时，在对称轴同侧画点。",
      "连接点时顺序错误，导致补出来的图形形状怪异。"
    ],
    "tips": "数格点时要细心，建议从上到下，先标点后连线。",

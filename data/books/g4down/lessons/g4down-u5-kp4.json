  "knowledge": {
    "point": "三角形的内角和",
    "core_concept": "任意一个三角形的三个内角之和都是180度。利用这个结论可以计算三角形中未知角的度数。",
    "key_formula": "三角形内角和 = 180^\\circ",
    "common_mistakes": [
      "认为大的三角形内角和大，小的三角形内角和小。",
      "等腰三角形计算角度时，忘记有两个底角相等。"
    ],
    "tips": "等腰三角形求角：已知顶角求底角用 $(180 - 顶角) \\div 2$；已知底角求顶角用 $180 - 底角 \\times 2$。",

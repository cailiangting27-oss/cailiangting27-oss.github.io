  "knowledge": {
    "point": "综合计算与验算能力",
    "core_concept": "全面复习四则运算顺序（先括号内，再乘除，后加减）和五大运算定律（加法交换律、结合律，乘法交换律、结合律、分配律）。学会观察数字特征（如25与4，125与8），合理运用简便算法提高计算效率，并养成“一步一验算”的闭环思维习惯。",
    "key_formula": "$a \\times (b + c) = a \\times b + a \\times c$ (乘法分配律)",
    "common_mistakes": [
      "在使用乘法分配律简算 $99 \times 38 + 38$ 时，漏掉隐含的 $38 \times 1$。",
      "减法性质应用错误，如 $480 \times 20 \times 2$ 误算为除法操作。"
    ],
    "tips": "看到25找4，看到125找8；看到99或101要想到转化成 (100-1) 或 (100+1)。",

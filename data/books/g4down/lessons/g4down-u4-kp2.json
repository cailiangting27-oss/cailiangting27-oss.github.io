  "knowledge": {
    "point": "小数的读法与写法",
    "core_concept": "读小数时，整数部分按整数读法来读，小数点读作“点”，小数部分依次读出每个数字。写小数时，小数点写在个位的右下角。",
    "key_formula": "\\text{读/写原则：整数部分按原样，小数点读点，小数部分依次报数}",
    "common_mistakes": [
      "读小数部分时像读整数一样（如把0.25读作零点二十五）",
      "写数时丢掉小数点"
    ],
    "tips": "小数部分无论有几个0，都要一个一个读出来。",

  "knowledge": {
    "point": "多边形的内角和探索",
    "core_concept": "通过从多边形的一个顶点引出对角线，可以将多边形分割成若干个三角形。多边形内角和等于（边数-2）个三角形内角和的总和。",
    "key_formula": "n 边形内角和 = (n - 2) \\times 180^\\circ",
    "common_mistakes": [
      "公式记错，误记为 $(n-1) \\times 180$。",
      "计算较大度数时发生进位或乘法错误。"
    ],
    "tips": "记住转化的思想，把不认识的多边形拆成认识的三角形。",

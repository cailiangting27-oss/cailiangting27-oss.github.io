  "knowledge": {
    "point": "小数点移动引起小数大小的变化",
    "core_concept": "小数点向右移：移动一位、两位、三位...，小数扩大到原数的10倍、100倍、1000倍。向左移则对应缩小到原数的1/10、1/100、1/1000。",
    "key_formula": "\\text{右移扩大 (乘), 左移缩小 (除)}",
    "common_mistakes": [
      "位数不够移时不知道补 0 占位",
      "搞混左移和右移对应的扩大/缩小方向"
    ],
    "tips": "口诀：左小右大。像跳跳蛙一样数小数点划过的数字个数。",

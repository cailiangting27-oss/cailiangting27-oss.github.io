  "knowledge": {
    "point": "拟人化表达与动词搭配",
    "core_concept": "本单元强调了动词运用的精准性，如“披、鼓、露、甩”等词将小动物描写得活灵活现。通过拟人手法，将水、植物、动物赋予人的情感和动作，使科普知识变得亲切生动，增强语言的感染力和趣味性。",
    "key_formula": "动词精准搭配：动作+特定部位（如：甩+长尾巴）。",
    "common_mistakes": [
      "动词错位使用，如“挂着绿衣裳”（应用“披”）",
      "无法体会“迎”与“追”在具体语境下的情感差异"
    ],
    "tips": "结合肢体表演来体会“披、露、鼓、甩”的动作，建立感官连接。",

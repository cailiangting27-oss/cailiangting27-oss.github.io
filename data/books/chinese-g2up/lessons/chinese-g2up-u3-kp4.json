  "knowledge": {
    "point": "动宾短语积累与关联词运用",
    "core_concept": "侧重于积累‘动词+名词’的常见搭配（如弹、唱、画、捏等艺术动作），并能熟练运用并列关联词‘一边……一边……’描述同时发生的行为。这旨在增强学生语言的准确性及描述复杂动态场景的能力。",
    "key_formula": "主语 + 一边 + 动词A + 一边 + 动词B",
    "common_mistakes": [
      "把不能同时进行的动作连在一起，如‘一边睡觉一边写作业’",
      "动词搭配不当，如‘吹钢琴’、‘捏图画’"
    ],
    "tips": "玩‘词语对对碰’，老师说动作词，学生快速说出对应的物品词。",

  "knowledge": {
    "point": "生活实物识字与四字词语",
    "core_concept": "语文学习不局限于课本，通过车票、门票、标牌等实物识记生活常用字。同时积累描写山色水秀、风景如画的四字词语，增加词汇量，提升描写家乡时的语言丰富度。",
    "key_formula": "看实物+读汉字+联生活+记词语",
    "common_mistakes": [
      "成语书写时容易出现同音字错别字（如：名胜古‘机’）",
      "不理解成语意思造成乱用"
    ],
    "tips": "随身带本记事本，把逛超市或乘车时见到的生字记下来，分类记忆。",

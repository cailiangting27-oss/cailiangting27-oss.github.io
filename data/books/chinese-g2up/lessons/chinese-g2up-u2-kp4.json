  "knowledge": {
    "point": "部首查字法操作流程",
    "core_concept": "部首查字法是低年级学生必须掌握的工具性技能。步骤包括：提取部首、部首目录查页码、检字表数剩余笔画找字、翻正文。适用于知道字形但不知道读音的情况。",
    "key_formula": "定部首 -> 找目录 -> 找检字表 -> 翻正文",
    "common_mistakes": [
      "数部首笔画不准导致找不到页码",
      "查检字表时数错除去部首外的笔画数"
    ],
    "tips": "遇到合体字通常查偏旁，遇到独体字通常查第一笔。",

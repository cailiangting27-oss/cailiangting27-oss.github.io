  "knowledge": {
    "point": "四季农事规律识记",
    "core_concept": "了解一年四季循环中农业生产的先后顺序。春天播种、夏天劳作（插秧采桑）、秋天收获（打场）、冬天修整（制棉衣），感知农民劳动的辛苦与汗水。",
    "key_formula": "春种 -> 夏长 -> 秋收 -> 冬藏",
    "common_mistakes": [
      "将秋季的收割提前到春季",
      "不理解“插秧”和“采桑”发生的具体季节"
    ],
    "tips": "联系生活实际，夏天最热的时候是农事最忙的时候。",

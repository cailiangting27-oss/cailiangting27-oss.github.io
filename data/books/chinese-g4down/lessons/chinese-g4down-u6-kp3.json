  "knowledge": {
    "point": "英雄人物的精神品质分析",
    "core_concept": "阅读《小英雄雨来》和《芦花鞋》，学习通过人物的言行、举止尤其是心理活动和细节描写来感受人物性格。雨来的机智果断、青铜的坚韧无私，都是通过一个个具体的生活细节塑造出来的。",
    "key_formula": "抓描写（动作/语言）+ 联想背景 = 概括性格特征",
    "common_mistakes": [
      "概括性格只用‘好’、‘坏’等简单词汇",
      "分析人物时脱离课文具体情节，主观臆断"
    ],
    "tips": "关注反复出现的句子（如“我们是中国人”），那往往是人物精神的支柱。",

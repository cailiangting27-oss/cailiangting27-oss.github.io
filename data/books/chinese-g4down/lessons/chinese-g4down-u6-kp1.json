  "knowledge": {
    "point": "长文章的小标题概括",
    "core_concept": "学习如何从篇幅较长的文章中提炼核心信息。通过关注文章的分段标志（如空行、序号），概括出每一部分的主要情节。小标题应当简洁明了，能体现该部分内容的特点，且全篇的小标题在字数和结构上应尽量保持平衡。",
    "key_formula": "找情节关键词 + 精简语言 = 准确的小标题",
    "common_mistakes": [
      "小标题起得太长，像一句话句意总结",
      "标题概括不全，只说了细枝末节"
    ],
    "tips": "可以尝试用文中出现的具有代表性的物件、动作或关键情节作为标题。",

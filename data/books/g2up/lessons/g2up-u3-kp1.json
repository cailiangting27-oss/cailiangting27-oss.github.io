  "knowledge": {
    "point": "角的认识与特征",
    "core_concept": "角是由一个共同的中心点（叫做顶点）引出的两条直直的线（叫做边）所形成的图形。角的大小与两条边张开的程度有关：开口越大，角就越大；开口越小，角就越小。特别要注意，角的大小和边的长短一点关系都没有。",
    "key_formula": "角 = 1个顶点 + 2条直边",
    "common_mistakes": [
      "认为边越长角就越大",
      "把有曲线的图形（如半圆）也当成角"
    ],
    "tips": "记口诀：小小角，真简单，一个顶点两条边；想知角的大小，只看开口不看边。",

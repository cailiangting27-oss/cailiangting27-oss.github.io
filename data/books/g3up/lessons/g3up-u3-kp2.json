  "knowledge": {
    "point": "千米的认识与路程估测",
    "core_concept": "千米(km)也叫公里，是计量比较长的距离时使用的单位。1千米等于1000米。我们要学会在生活中估测距离，比如标准操场跑2圈半就是1000米，步行约15分钟也是1千米。",
    "key_formula": "$1km = 1000m$",
    "common_mistakes": [
      "将千米和米之间的进率误认为10或100。",
      "估算路程时，单位选择不当（如把城市距离写成米）。"
    ],
    "tips": "记住“3个0”法则，千米变米要在数字后面加3个0。",

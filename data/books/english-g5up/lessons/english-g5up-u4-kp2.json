  "knowledge": {
    "point": "情态动词can的肯否定用法",
    "core_concept": "can表示'能'，后面接动词原形，否定形式为can't。",
    "key_formula": "主语 + can/can't + 动词原形 (+ 其他).",
    "common_mistakes": [
      "在can后面误用动词ing形式或三单形式",
      "回答Can you...时误用Yes, I do."
    ],
    "tips": "记住can是一个'法力无边'的词，它可以让后面的动词全部变回原形。",

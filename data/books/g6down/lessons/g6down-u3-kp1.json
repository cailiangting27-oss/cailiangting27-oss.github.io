  "knowledge": {
    "point": "圆柱与圆锥的特征",
    "core_concept": "圆柱由两个完全相同的底面（圆）和一个侧面（曲面）组成，侧面展开是长方形或正方形。圆锥由一个底面和一个侧面（曲面）组成，侧面展开是扇形。圆柱有无数条高，圆锥只有一条。以长方形的一边为轴旋转得到圆柱，以直角三角形的一条直角边为轴旋转得到圆锥。",
    "key_formula": "圆柱侧面展开的长 = 底面周长 = $2 \times \text{PI} \times r$",
    "common_mistakes": [
      "错误地认为圆锥侧面展开是三角形。",
      "认为圆柱只有两条高（把轴线和边缘线误认为仅有的高）。"
    ],
    "tips": "想象转笔或旋转门的过程，帮助建立空间观念。",

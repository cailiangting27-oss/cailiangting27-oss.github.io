  "knowledge": {
    "point": "用比例解决问题",
    "core_concept": "分析题目中哪种量是不变的，从而建立比例关系式。正比例用除法式建立方程，反比例用乘法式建立方程。",
    "key_formula": "$\frac{x_1}{y_1} = \frac{x_2}{y_2} \text{ 或 } x_1y_1 = x_2y_2$",
    "common_mistakes": [
      "选错比例类型（把反比例题按正比例做）",
      "列比例式时对应位置放错"
    ],
    "tips": "做题三步走：一判（判断正反比）、二列（列出比例方程）、三解（求出未知数）。",

  "knowledge": {
    "point": "图形的放大与缩小",
    "core_concept": "按比例改变图形的大小，但不改变形状。边长扩大 $n$ 倍，周长扩大 $n$ 倍，面积扩大 $n^2$ 倍。",
    "key_formula": "$\text{新边长} = \text{旧边长} \times \text{比例}$",
    "common_mistakes": [
      "误认为面积也按照边长比例相同倍数扩大",
      "画图时只扩大长而忘记扩大宽"
    ],
    "tips": "图形变了大小没变脸，关键抓住各边对应的比值相同。",

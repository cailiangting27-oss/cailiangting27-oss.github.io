  "knowledge": {
    "point": "比例尺的应用",
    "core_concept": "图上距离与实际距离的比。注意比例尺没有单位，计算时必须先将图上距离和实际距离化成相同的单位（通常化成厘米）。",
    "key_formula": "$\text{比例尺} = \frac{\text{图上距离}}{\text{实际距离}}$",
    "common_mistakes": [
      "单位换算不熟练，少写或多写 0（1千米=100000厘米）",
      "将比例尺的前后项颠倒"
    ],
    "tips": "放大比例尺前项大（如$20:1$），缩小比例尺后项大（如$1:5000$）。",

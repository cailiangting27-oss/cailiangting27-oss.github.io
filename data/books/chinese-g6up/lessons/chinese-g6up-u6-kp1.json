  "knowledge": {
    "point": "关键句的提取与观点把握",
    "core_concept": "阅读写景或说明性文章时，要重点关注文章的开头、结尾以及段落的起首句。这些地方往往隐藏着作者的观点或全篇的中心。通过合并各部分的中心意思，就能准确把握作者想要传达的核心价值。在《只有一个地球》中，结论正是在层层论述后在文末点明。",
    "key_formula": "找中心句 = 首句（总起）+ 尾句（总结）+ 过渡句（承上启下）",
    "common_mistakes": [
      "将文中的生动描写误认为是核心观点。",
      "提取关键句时只摘录一半，导致意思不完整。"
    ],
    "tips": "朗读时遇到作者发出的感叹或号召，通常就是关键句所在。",

  "knowledge": {
    "point": "非连续性文本的信息提取",
    "core_concept": "非连续性文本是指由文字、统计图表、图画、地图、说明书等多种形式组成的材料。阅读时需要通过观察图表的标题、坐标、图例、关键文字说明，并进行综合对比和关联，从而得出有用的结论或规划具体的行动方案。",
    "key_formula": "观察图画/图标 + 关联文字信息 = 综合结论",
    "common_mistakes": [
      "只看文字而忽略了关键的图表或地图信息",
      "无法将多份材料中的信息点进行整合，导致判断片面"
    ],
    "tips": "阅读图表时，要重点关注图例（解释颜色或符号含义的地方）和方位标识。",

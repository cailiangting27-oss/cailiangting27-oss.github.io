  "knowledge": {
    "point": "习作：把情感写具体",
    "core_concept": "习作要求将成长过程中的某一刻情感（如惭愧、自豪、感动）放大。通过细致入微的动作捕捉、神态细节的刻画以及环境气氛的烘托，让文字具有感染力。",
    "key_formula": "动作分解 + 神态捕捉 + 景物衬托 = 情感具体化",
    "common_mistakes": [
      "只会用‘我非常开心’这种描述，没有具体的细节支撑。",
      "流水账式记录过程，忽略了‘那一刻’的心理特写。"
    ],
    "tips": "练习‘慢动作回放’，把一个简单的开门动作拆解成转把手、推门、屏住呼吸等小细节。",
